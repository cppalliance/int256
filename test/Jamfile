# Warnings about padding propagate out of <utility>. Do not fold these onto one
# line: BoostTestJamfile.cmake only recognizes a line whose whole remainder is a
# single source, so `run test_hash.cpp : : : <requirement> ;` on one line is
# silently skipped by the CMake build and the test is never run there.
run test_hash.cpp
    : : : <toolset>msvc:<cxxflags>/wd4324 ;
run test_container_hash.cpp
    : : : <toolset>msvc:<cxxflags>/wd4324 ;

run limits_link_1.cpp limits_link_2.cpp limits_link_3.cpp ;

run-fail benchmark_u256.cpp ;
run-fail benchmark_i256.cpp ;

# Configuration targets that re-run a test with the builtin 128-bit intermediates
# switched off. These stay on one line so the CMake Jamfile parser skips them and
# does not collide with the plain target built from the same source.
run test_u256_vs_multiprecision.cpp : : : <define>BOOST_INT256_NO_BUILTIN_INT128 : test_u256_vs_multiprecision_no_builtin ;
run test_u256.cpp : : : <define>BOOST_INT256_NO_BUILTIN_INT128 : test_u256_no_builtin ;
run test_bit.cpp : : : <define>BOOST_INT256_NO_BUILTIN_INT128 : test_bit_no_builtin ;
run test_div.cpp : : : <define>BOOST_INT256_NO_BUILTIN_INT128 : test_div_no_builtin ;
run test_byte_conversions.cpp : : : <define>BOOST_INT256_NO_BUILTIN_INT128 : test_byte_conversions_no_builtin ;
run test_i256_vs_multiprecision.cpp : : : <define>BOOST_INT256_NO_BUILTIN_INT128 : test_i256_vs_multiprecision_no_builtin ;
run test_i256.cpp : : : <define>BOOST_INT256_NO_BUILTIN_INT128 : test_i256_no_builtin ;
run test_int128_interop.cpp : : : <define>BOOST_INT256_NO_BUILTIN_INT128 <define>BOOST_INT128_NO_BUILTIN_INT128 : test_int128_interop_no_builtin ;

