@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/boost_int256Targets.cmake")

# Recreate the alias for the imported target
if(NOT TARGET Boost::int256 AND TARGET Boost::boost_int256)
    add_library(Boost::int256 ALIAS Boost::boost_int256)
endif()

check_required_components(boost_int256)

set(boost_int256_FOUND TRUE)
