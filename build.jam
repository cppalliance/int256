require-b2 5.2 ;

constant boost_dependencies :
    /boost/assert//boost_int128 ;

project /boost/int256
    : common-requirements
        <include>include
    ;

explicit
    [ alias boost_int256 : : : : <include>include <library>$(boost_dependencies) ]
    [ alias all : boost_int256 test ]
    ;

call-if : boost-library int256
    : install boost_int256
    ;
